{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registration.started.v1",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "aggregate_type", "aggregate_id", "source_service", "occurred_at", "payload"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "registration.started"},
    "schema_version": {"const": 1},
    "aggregate_type": {"const": "registration"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "aggregate_version": {"type": "integer", "minimum": 1},
    "source_service": {"const": "registration-saga-service"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object", "required": ["session_id", "client_id", "user_id", "email", "username"], "additionalProperties": true}
  },
  "additionalProperties": false
}
