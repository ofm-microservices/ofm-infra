package http

import "github.com/ofm/load-test-service/internal/application"
import "fmt"

templ Home(jobs []application.Job) {
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>OFM Experiment Service</title><script src="https://unpkg.com/htmx.org@2.0.4"></script><style>body{margin:0;background:#f4f6f8;color:#17202a;font-family:system-ui,sans-serif}main{max-width:1180px;margin:0 auto;padding:42px 24px;text-align:center}.toolbar{display:grid;grid-template-columns:repeat(5,minmax(150px,1fr));gap:16px;margin:28px 0;text-align:left}.toolbar label{display:flex;flex-direction:column;gap:6px;font-size:14px}.toolbar input,.toolbar select,.toolbar button{padding:9px 12px;border:1px solid #c8d0d8;border-radius:6px;font:inherit;background:#fff}.toolbar .section{grid-column:1/-1;color:#9a3412;font-size:16px;font-weight:700;border-bottom:2px solid #fed7aa;padding-bottom:8px;margin-top:6px}.toolbar .wide{grid-column:span 2}.toolbar .check{flex-direction:row;align-items:center;padding-top:26px}.toolbar button{grid-column:1/-1;background:#1769aa;color:white;border:0;cursor:pointer;height:44px;font-weight:600}table{width:100%;border-collapse:collapse;background:white;text-align:left;box-shadow:0 2px 8px #0001}th,td{padding:12px;border-bottom:1px solid #e5e7eb}.state{font-weight:700}.COMPLETED{color:#18794e}.FAILED{color:#b42318}a{color:#1769aa}@media(max-width:900px){.toolbar{grid-template-columns:repeat(2,minmax(150px,1fr))}.toolbar .wide{grid-column:span 2}}@media(max-width:560px){.toolbar{grid-template-columns:1fr}.toolbar .wide{grid-column:span 1}}</style></head><body><main>
<h1>OFM Experiment Service</h1>
<form class="toolbar" hx-post="/runs" hx-target="#jobs" hx-swap="outerHTML">
<input name="workload" type="hidden" value="resilience"/><input name="profile" type="hidden" value="mixed"/><label>Load mode<select name="load_mode"><option value="manual">Manual RPS</option><option value="pc-capacity">PC capacity — 90% CPU</option></select></label>
<label>Read RPS<input name="read_rps" type="number" min="0" value="80"/></label><label>Write RPS<input name="write_rps" type="number" min="0" value="20"/></label>
<input name="vus" type="hidden" value="1"/><input name="pre_allocated_vus" type="hidden" value="200"/><input name="max_vus" type="hidden" value="1000"/><label>Minutes<input name="minutes" type="number" min="1" value="10"/></label>
<label class="section">Fault injection and recovery</label>
<label>Fault profile<select name="fault_profile"><option value="none">None</option><option value="service-down">Service down (k3d controller)</option><option value="delay">Delay</option><option value="error">Error</option><option value="mixed">Mixed</option></select></label><label>Fault target<input name="fault_target" value="search-service"/></label><label>Fault at<input name="fault_at" placeholder="120s"/></label><label>Fault duration<input name="fault_duration" placeholder="120s"/></label><label>Error rate %<input name="fault_rate" type="number" min="0" max="100" step="0.1" value="0"/></label><label>Fault delay<input name="fault_delay" placeholder="0s"/></label><label>Max faults<input name="fault_max_failures" type="number" min="0" value="0"/></label><label>Fault TTL<input name="fault_ttl" placeholder="0s"/></label><label class="check"><input name="accept_5xx" type="checkbox"/> Accept expected 5xx</label><label class="check"><input name="allow_slow" type="checkbox"/> Allow slow p95</label>
<button type="submit">Start experiment</button></form>
<p class="mode-note">Mixed запускає весь налаштований traffic mix протягом заданої кількості хвилин. Total RPS = Read RPS + Write RPS.</p><script>document.addEventListener('change',function(e){if(e.target.name==='fault_profile'&&e.target.value==='service-down'){document.querySelector('[name="fault_target"]').value='search-service';document.querySelector('[name="fault_at"]').value='120s';document.querySelector('[name="fault_duration"]').value='120s'}});</script>
@JobTable(jobs)
</main></body></html>
}

templ JobTable(jobs []application.Job) {
<section id="jobs" hx-get="/runs" hx-trigger="every 5s" hx-select="#jobs" hx-swap="outerHTML"><h2>Jobs</h2><table><thead><tr><th>Run ID</th><th>Message</th><th>Status</th></tr></thead><tbody>
for _, job := range jobs {
<tr><td><a href={ templ.URL("/runs/"+job.Name) }>{ job.RunID }</a></td><td>{ job.Message }</td><td class={ "state "+job.State }>{ job.State }</td></tr>
}
</tbody></table></section>
}

templ Button(label string, method string, target string) { <button class="button" hx-delete={ method } hx-confirm="Stop this experiment?" hx-target={ target } hx-swap="outerHTML">{ label }</button> }
templ LinkButton(label string, href string) { <a class="button button-link" href={ templ.URL(href) } target="_blank" rel="noopener">{ label }</a> }

templ Details(job application.Job, payload string) {
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Experiment — { job.State }</title><script src="https://unpkg.com/htmx.org@2.0.4"></script><style>body{margin:0;background:#f4f6f8;font-family:system-ui,sans-serif}main{max-width:760px;margin:0 auto;padding:48px 24px;text-align:center}pre{padding:20px;background:#17202a;color:#e8eef2;border-radius:8px;text-align:left;overflow:auto}.button{display:inline-block;padding:9px 12px;border-radius:6px;background:#1769aa;color:white;text-decoration:none;margin:4px}a{color:#1769aa}</style></head><body>@DetailsContent(job,payload)</body></html>
}

templ DetailsContent(job application.Job, payload string) {
<main hx-get={ "/runs/"+job.Name } hx-trigger="every 1s" hx-target="this" hx-swap="outerHTML"><h1>Experiment — <span class={ "state "+job.State }>{ job.State }</span></h1><p>{ job.Message }</p><p>@LinkButton("Open in Grafana", "http://grafana.localhost/d/ofm-experiments?var-run_id="+job.RunID)</p>
if job.State == "PENDING" || job.State == "RUNNING" {
if job.DurationSeconds > 0 {
<p>Time remaining: { fmt.Sprint(job.RemainingSeconds) } seconds</p>
} else {
<p>Capacity ramp-up in progress — waiting for the 90% CPU limit.</p>
}
}
if job.State == "PENDING" || job.State == "RUNNING" {
@Button("Stop", "/runs/"+job.Name, "main")
}
<pre>{ payload }</pre><p><a href="/">Back to runner</a></p></main>
}
